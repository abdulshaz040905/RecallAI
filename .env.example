# =============================================================================
# Recall AI — environment variables
#
# Copy this file to `.env` and fill in each value.
#   cp .env.example .env
#
# Everything is left blank on purpose — fill in the quotes yourself.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS, local — anything Postgres).
DATABASE_URL=


# Direct (non-pooled) connection. Only needed if your host uses PgBouncer.
DIRECT_URL=

# Public base URL of the app. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=


# -----------------------------------------------------------------------------
# AI — Google Gemini (replaces OpenAI; the free tier is enough to run this)
#
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with a Google account -> "Create API key"
# 3. Pick or create a Google Cloud project, then copy the key (starts "AIza...")
#
# No credit card needed for the free tier.
# -----------------------------------------------------------------------------

GEMINI_API_KEY=

# Optional overrides — defaults are current stable models as of August 2026.
# Do NOT use gemini-2.0-flash (shut down March 2026) or text-embedding-004
# (deprecated January 2026); both now fail at request time.
#
# GEMINI_CHAT_MODEL="gemini-3.6-flash"          # default; balanced
# GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"     # cheaper + faster alternative
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# GEMINI_EMBEDDING_DIMENSIONS="768"             # must match your Pinecone index


# -----------------------------------------------------------------------------
# Vector search — Pinecone
#
# 1. Sign up at https://app.pinecone.io (free "Starter" tier)
# 2. API keys -> Create API key -> copy it
# 3. Indexes -> Create index. Name it whatever you like, then set:
#       Dimension = 768        (must match GEMINI_EMBEDDING_DIMENSIONS above)
#       Metric    = cosine
#
# gemini-embedding-001 returns 3072 dims by default; the app truncates to 768
# via Matryoshka scaling to keep the index small. If you previously used OpenAI
# at 1536 dims, that index is incompatible — create a new one.
# -----------------------------------------------------------------------------

PINECONE_API_KEY=
PINECONE_INDEX_NAME=


# -----------------------------------------------------------------------------
# Transcript translation — Google Cloud Translation API
# Enable "Cloud Translation API" in Google Cloud, then create an API key.
# -----------------------------------------------------------------------------

GOOGLE_TRANSLATE_API_KEY=


# -----------------------------------------------------------------------------
# Auth — Clerk
# -----------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/home"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/home"

# Random 32+ character string used to sign OAuth `state` parameters.
# Generate one with:  openssl rand -hex 32
OAUTH_STATE_SECRET=


# -----------------------------------------------------------------------------
# Meeting bot — MeetingBaaS
# -----------------------------------------------------------------------------

MEETING_BAAS_API_KEY=
WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Google Calendar OAuth
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# -----------------------------------------------------------------------------
# Integrations — Notion
# https://www.notion.so/my-integrations  (create a "Public" integration)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/notion/callback
# -----------------------------------------------------------------------------

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Integrations — Linear
# https://linear.app/settings/api/applications/new
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/linear/callback
# -----------------------------------------------------------------------------

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Integrations — Salesforce
# Setup → App Manager → New Connected App → Enable OAuth
# Scopes: api, refresh_token, offline_access, id
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/integrations/salesforce/callback
# -----------------------------------------------------------------------------

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# https://login.salesforce.com for production,
# https://test.salesforce.com for a sandbox.
SALESFORCE_LOGIN_URL=

# Optional, defaults to v60.0
# SALESFORCE_API_VERSION="v60.0"




# -----------------------------------------------------------------------------
# Integrations — Jira / Atlassian
# -----------------------------------------------------------------------------

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=




# -----------------------------------------------------------------------------
# Integrations — Trello
# -----------------------------------------------------------------------------

TRELLO_API_KEY=


# -----------------------------------------------------------------------------
# Integrations — Slack
# -----------------------------------------------------------------------------

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_REDIRECT_URL=


# -----------------------------------------------------------------------------
# Email — Gmail SMTP (free) used for summaries and workspace invites
# Requires a Google App Password, not your normal password.
# -----------------------------------------------------------------------------

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative provider (optional, if you use lib/email-service.tsx instead)
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# Billing — Razorpay (test mode)
# -----------------------------------------------------------------------------
#
# 1. Razorpay Dashboard → toggle "Test Mode" (top right).
# 2. Settings → API Keys → Generate Test Key. Test keys start with "rzp_test_".
# 3. Subscriptions → Plans → create three monthly INR plans:
#       Starter  ₹99    Pro  ₹199    Premium  ₹299
#    Copy each plan id ("plan_...") below.
# 4. Settings → Webhooks → add <your app url>/api/webhooks/razorpay with the
#    events: subscription.activated, subscription.charged, subscription.halted,
#    subscription.cancelled, subscription.completed. Copy the webhook secret.
#
# Local testing: expose your dev server with a tunnel (e.g. `ngrok http 3000`)
# and point the webhook at the tunnel URL, or Razorpay cannot reach you.
#
# Test card: 4111 1111 1111 1111, any future expiry, any CVV, OTP 1111.

RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Plan ids stay server-side — the browser only ever sends a plan name.
RAZORPAY_STARTER_PLAN_ID="plan_xxxxxxxxxxxxxx"
RAZORPAY_PRO_PLAN_ID="plan_xxxxxxxxxxxxxx"
RAZORPAY_PREMIUM_PLAN_ID="plan_xxxxxxxxxxxxxx"


# -----------------------------------------------------------------------------
# Storage — AWS S3 (bot avatars)
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
